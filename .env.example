# Google Sheets設定
# スプレッドシートIDはURLから取得: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SHEET_ID=your_spreadsheet_id_here
GOOGLE_CREDENTIALS_PATH=./credentials.json
# 日本語環境のスプレッドシートは「シート1」、英語環境は「Sheet1」
GOOGLE_SHEET_RANGE=シート1!A:B

# Ollama設定（オプション - より高度な問題生成に使用）
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama2
# Ollamaの事前生成間隔（秒）
OLLAMA_PREGEN_INTERVAL_SECONDS=270
# 1回の事前生成バッチサイズ
OLLAMA_MODEL_BATCH_SIZE=4
# キャッシュの最大保持数
OLLAMA_CACHE_MAX=50
# 事前生成プロセスのnice値
OLLAMA_BATCH_NICE=10

# アプリ設定
# クイズの表示間隔（分）
QUIZ_INTERVAL_MINUTES=5
# 起動時に自動でクイズを開始するか（true/false）
AUTO_START_QUIZ=true

# 忘却曲線設定
# 学習記録を保存するシート名（同一スプレッドシート内に自動作成）
LEARNING_SHEET_NAME=学習記録
# SM-2アルゴリズムの初期難易度係数（デフォルト2.5）
INITIAL_EASE_FACTOR=2.5
# 不正解時の再出題間隔（分）
INCORRECT_RETRY_MINUTES=5

# アイコン設定（オプション）
APP_ICON=📚
