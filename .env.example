# VocabLib 環境変数のテンプレート
# 使い方: cp .env.example .env して、値を埋める
# .env は .gitignore で除外されている。絶対にコミットしないこと。

# ── Phase 2（メニューバーUI）で使用 ──────────────────────────────
# クイズの出題間隔（分）
QUIZ_INTERVAL_MINUTES=5
# 選択肢の数（正解を含む）
CHOICE_COUNT=4
# 起動時に自動出題を開始するか
AUTO_START_QUIZ=true
# ローカルDBの位置を上書きする（開発用。未設定なら
# ~/Library/Application Support/VocabLib/vocablib.db）
# VOCABLIB_DB_PATH=

# ── Phase 3（LLM）で使用 ────────────────────────────────────────
# 1段目: Gemini。https://aistudio.google.com/apikey で取得。
# 空のままなら Gemini はスキップされ、2段目のOllamaから始まる。
GEMINI_API_KEY=
# 利用可能なモデルは以下で確認できる:
#   curl -s -H "x-goog-api-key: $KEY" \
#     "https://generativelanguage.googleapis.com/v1beta/models?pageSize=200"
# 常に最新を追うなら gemini-flash-latest。ここでは出力を安定させるためピン留めする。
GEMINI_MODEL=gemini-3.7-flash

# 2段目: ローカルLLMフォールバック（Ollama）
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# 例文生成の待ち時間上限（秒）。ワーカースレッドで動くので長めでよい
LLM_TIMEOUT_SECONDS=20
# 単語登録オートフィルの待ち時間上限（秒）。UIを止めるので短くしたいが、
# Gemini APIは10秒未満のデッドラインを400で拒否するためこれが下限。
AUTOFILL_TIMEOUT_SECONDS=10

# ログの詳細度。DEBUG にすると、どの段がなぜ失敗して次に落ちたかまで出る
LOG_LEVEL=INFO

# ── Phase 4（Supabase同期）で使用 ───────────────────────────────
# Supabaseプロジェクトの URL と service_role キー。
# service_role は RLS を無視する管理者キー。Macアプリ内でのみ使用し、
# ブラウザ・Webフロントエンド・Gitには絶対に置かないこと。
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 送信する行に付ける所有者ID。Web側のRLSポリシーが auth.uid() = user_id で
# 判定するため、これが無いとWebから見えない。
# 確認方法: Supabase SQL Editor で `select id, email from auth.users;`
SUPABASE_USER_ID=

# 自動同期の間隔（分）。どちらか未設定なら同期は丸ごと無効になり、
# アプリはローカル完結で動く。
SYNC_INTERVAL_MINUTES=10
