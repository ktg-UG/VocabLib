# Google Sheets設定
# スプレッドシートIDはURLから取得: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SHEET_ID=your_spreadsheet_id_here
GOOGLE_CREDENTIALS_PATH=./credentials.json
# 日本語環境のスプレッドシートは「シート1」、英語環境は「Sheet1」
GOOGLE_SHEET_RANGE=シート1!A:B

# Ollama設定（オプション - より高度な問題生成に使用）
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama2

# アプリ設定
# クイズの表示間隔（分）
QUIZ_INTERVAL_MINUTES=5

# アイコン設定（オプション）
APP_ICON=📚
